rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // KOLEKSI: USERS (Akun Kasir & Admin)
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // KOLEKSI: PRODUCTS (Master Menu Makanan & Minuman)
    // -------------------------------------------------------------
    match /products/{productId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // KOLEKSI: TRANSACTIONS (Pencatatan Penjualan Kasir Real-Time)
    // -------------------------------------------------------------
    match /transactions/{trxId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // KOLEKSI: EMPLOYEES (Master Data Staf & Karyawan)
    // -------------------------------------------------------------
    match /employees/{empId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // KOLEKSI: PAYROLL (Slip Gaji & Riwayat Penggajian)
    // -------------------------------------------------------------
    match /payroll/{slipId} {
      allow read, write: if true;
    }
    // -------------------------------------------------------------
    // KOLEKSI: SETTINGS (Pengaturan Sistem & Kunci Autentikasi Admin)
    // -------------------------------------------------------------
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // KOLEKSI: REFERRAL_CODES (OTP Referral Verifikasi Email)
    // -------------------------------------------------------------
    match /referralCodes/{email} {
      allow read, write: if true;
    }
  }
}
