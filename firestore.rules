rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // FUNGSI BANTUAN KEAMANAN & OTORISASI (ZERO TRUST)
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userProfileExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return getUserDoc().data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'istanabubur89@gmail.com' ||
        request.auth.token.admin == true ||
        request.auth.uid == 'admin' ||
        (userProfileExists() && (getUserData().role == 'Admin' || getUserData().role == 'admin'))
      );
    }

    function isKasir() {
      return isSignedIn() && (
        userProfileExists() && (getUserData().role == 'Kasir' || getUserData().role == 'kasir')
      );
    }

    function getUserOutletId() {
      return getUserData().outletId;
    }

    // -------------------------------------------------------------
    // 1. KOLEKSI: USERS (Akun & Profil Pengguna)
    // - Kasir HANYA boleh membaca data profil miliknya sendiri (UID sama).
    // - Kasir DILARANG membaca list seluruh akun pengguna (mencegah user scraping).
    // - Admin berwenang mengelola seluruh profil akun pengguna.
    // -------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 2. KOLEKSI: TRANSACTIONS (Pencatatan Penjualan POS Per-Outlet)
    // - Kasir Outlet A HANYA bisa membaca & query transaksi milik Outlet A.
    // - Kasir Outlet A HANYA bisa membuat transaksi untuk Outlet A miliknya.
    // - Kasir DILARANG membaca, mengubah, atau menghapus transaksi Outlet B.
    // - Admin memiliki wewenang penuh atas seluruh transaksi di 20 outlet.
    // -------------------------------------------------------------
    match /transactions/{trxId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        (isKasir() && resource.data.outletId == getUserOutletId())
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        (isKasir() && request.resource.data.outletId == getUserOutletId())
      ) && request.resource.data.total is number && request.resource.data.total >= 0;

      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 3. KOLEKSI: PRODUCTS (Master Menu Makanan & Minuman)
    // - Katalog menu dapat dibaca publik dan kasir POS untuk operasional.
    // - Modifikasi menu HANYA diizinkan untuk Admin Pusat.
    // -------------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 4. KOLEKSI: BRANCHES (Daftar Cabang Outlet Aktif)
    // -------------------------------------------------------------
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_deleted_branches/{branchId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 5. KOLEKSI: EMPLOYEES & PAYROLL (Data Karyawan & Slip Gaji)
    // - HANYA Admin yang berhak mengakses (Kasir dilarang melihat data sensitif ini).
    // -------------------------------------------------------------
    match /employees/{empId} {
      allow read, write: if isAdmin();
    }

    match /payroll/{slipId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 6. KOLEKSI: DOCUMENTS (Nota & Slip PDF untuk tautan unduh publik)
    // -------------------------------------------------------------
    match /documents/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // -------------------------------------------------------------
    // 7. KOLEKSI: SETTINGS (Pengaturan Sistem & Kunci Otorisasi)
    // -------------------------------------------------------------
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 8. KOLEKSI: REFERRAL_CODES & MAIL
    // - Dikelola oleh Cloud Functions (Admin SDK). Client dilarang menulis langsung.
    // -------------------------------------------------------------
    match /referralCodes/{email} {
      allow read, write: if false;
    }

    match /mail/{mailId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------
    // 9. KOLEKSI: CHAT & OBROLAN
    // -------------------------------------------------------------
    match /admin_conversations/{username} {
      allow read, write: if isSignedIn() && (
        (userProfileExists() && getUserData().username == username) ||
        request.auth.uid == username ||
        isAdmin()
      );
    }

    match /admin_chats/{username}/messages/{msgId} {
      allow read, write: if isSignedIn() && (
        (userProfileExists() && getUserData().username == username) ||
        request.auth.uid == username ||
        isAdmin()
      );
    }

    match /group_messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 3000;
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // DEFAULT CATCH-ALL: BLOKIR SELURUH AKSES LAIN
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
