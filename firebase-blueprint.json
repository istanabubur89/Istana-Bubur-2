{
  "entities": {
    "User": {
      "title": "User",
      "description": "Akun pengguna sistem kasir dan admin Istana Bubur",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID unik pengguna" },
        "fullName": { "type": "string", "maxLength": 100, "description": "Nama lengkap" },
        "username": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_.-]+$", "description": "Username akun" },
        "email": { "type": "string", "maxLength": 100, "description": "Email aktif pengguna" },
        "phone": { "type": "string", "maxLength": 25, "description": "Nomor WhatsApp" },
        "role": { "type": "string", "enum": ["Admin", "Kasir"], "description": "Peran hak akses" },
        "cabang": { "type": "string", "maxLength": 50, "description": "Nama cabang penempatan" },
        "isActive": { "type": "boolean", "description": "Status keaktifan akun" },
        "authCode": { "type": "string", "maxLength": 50, "description": "Kode autentikasi verifikasi" },
        "createdAt": { "type": "string", "description": "Waktu pendaftaran" }
      },
      "required": ["username", "role", "cabang"]
    },
    "Product": {
      "title": "Product",
      "description": "Menu makanan dan minuman Istana Bubur",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "description": "ID Produk (contoh: PRD-001)" },
        "nama": { "type": "string", "maxLength": 100, "description": "Nama produk makanan/minuman" },
        "harga": { "type": "number", "description": "Harga jual dalam Rupiah" },
        "gambar": { "type": "string", "description": "URL atau Base64 gambar produk" },
        "kategori": { "type": "string", "maxLength": 50, "description": "Kategori produk" }
      },
      "required": ["nama", "harga"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Catatan transaksi penjualan kasir",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "description": "ID Transaksi penjualan" },
        "tanggal": { "type": "string", "maxLength": 30, "description": "Tanggal transaksi" },
        "jam": { "type": "string", "maxLength": 20, "description": "Waktu jam transaksi" },
        "kasir": { "type": "string", "maxLength": 100, "description": "Nama atau username kasir" },
        "cabang": { "type": "string", "maxLength": 50, "description": "Cabang transaksi dibuat" },
        "total": { "type": "number", "description": "Total nominal belanja" },
        "metode": { "type": "string", "maxLength": 30, "description": "Metode pembayaran (Tunai/QRIS/Transfer)" },
        "status": { "type": "string", "maxLength": 30, "description": "Status transaksi (Selesai/Batal)" },
        "items": { "type": "string", "description": "Daftar item belanja dalam format serialized JSON" }
      },
      "required": ["id", "cabang", "total"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Data staf dan karyawan cabang Istana Bubur",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "description": "ID Karyawan" },
        "nama": { "type": "string", "maxLength": 100, "description": "Nama karyawan" },
        "posisi": { "type": "string", "maxLength": 50, "description": "Posisi jabatan" },
        "cabang": { "type": "string", "maxLength": 50, "description": "Cabang penempatan" },
        "gajiPokok": { "type": "number", "description": "Besaran gaji pokok bulanan" },
        "noWa": { "type": "string", "maxLength": 25, "description": "Nomor WhatsApp" },
        "status": { "type": "string", "maxLength": 30, "description": "Status kepegawaian (Aktif/Cuti/Nonaktif)" }
      },
      "required": ["id", "nama", "posisi", "cabang", "gajiPokok"]
    },
    "Payroll": {
      "title": "Payroll",
      "description": "Rekap slip gaji karyawan bulanan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "description": "ID Slip Gaji" },
        "tanggal": { "type": "string", "maxLength": 30, "description": "Tanggal penggajian" },
        "bulan": { "type": "string", "maxLength": 30, "description": "Bulan periode gaji" },
        "employeeId": { "type": "string", "maxLength": 50, "description": "ID Karyawan" },
        "nama": { "type": "string", "maxLength": 100, "description": "Nama karyawan penerima" },
        "cabang": { "type": "string", "maxLength": 50, "description": "Cabang" },
        "gajiPokok": { "type": "number", "description": "Gaji pokok" },
        "bonus": { "type": "number", "description": "Bonus insentif" },
        "potongan": { "type": "number", "description": "Potongan keterlambatan/kasbon" },
        "totalGaji": { "type": "number", "description": "Nominal total gaji yang diterima" }
      },
      "required": ["id", "bulan", "nama", "totalGaji"]
    },
    "AdminConversation": {
      "title": "AdminConversation",
      "description": "Daftar percakapan 1-on-1 antara user dan admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "description": "Username pengguna thread" },
        "username": { "type": "string", "maxLength": 50, "description": "Username akun" },
        "fullName": { "type": "string", "maxLength": 100, "description": "Nama lengkap pengguna" },
        "role": { "type": "string", "maxLength": 30, "description": "Role pengguna" },
        "cabang": { "type": "string", "maxLength": 50, "description": "Cabang penempatan" },
        "lastMessage": { "type": "string", "maxLength": 3000, "description": "Pesan terakhir" },
        "lastTimestamp": { "type": "string", "description": "Waktu pesan terakhir" },
        "unreadForAdmin": { "type": "number", "description": "Jumlah pesan belum dibaca oleh admin" },
        "unreadForUser": { "type": "number", "description": "Jumlah pesan belum dibaca oleh user" },
        "updatedAt": { "type": "string", "description": "Waktu pembaruan" }
      },
      "required": ["username", "lastMessage"]
    },
    "AdminChatMessage": {
      "title": "AdminChatMessage",
      "description": "Pesan chat pribadi antara user dan admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "description": "ID Pesan" },
        "senderUsername": { "type": "string", "maxLength": 50, "description": "Username pengirim" },
        "senderName": { "type": "string", "maxLength": 100, "description": "Nama pengirim" },
        "senderRole": { "type": "string", "maxLength": 30, "description": "Role pengirim" },
        "senderCabang": { "type": "string", "maxLength": 50, "description": "Cabang pengirim" },
        "text": { "type": "string", "maxLength": 3000, "description": "Isi pesan teks" },
        "imageUrl": { "type": "string", "description": "URL gambar atau Base64 terlampir" },
        "timestamp": { "type": "string", "description": "Format tanggal dan jam tampilan" },
        "createdAt": { "type": "number", "description": "Epoch timestamp" }
      },
      "required": ["senderUsername", "senderRole"]
    },
    "GroupChatMessage": {
      "title": "GroupChatMessage",
      "description": "Pesan dalam grup obrolan seluruh pengguna",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50, "description": "ID Pesan" },
        "senderUsername": { "type": "string", "maxLength": 50, "description": "Username pengirim" },
        "senderName": { "type": "string", "maxLength": 100, "description": "Nama pengirim" },
        "senderRole": { "type": "string", "maxLength": 30, "description": "Role pengirim" },
        "senderCabang": { "type": "string", "maxLength": 50, "description": "Cabang pengirim" },
        "text": { "type": "string", "maxLength": 3000, "description": "Isi pesan teks" },
        "imageUrl": { "type": "string", "description": "URL gambar atau Base64 terlampir" },
        "timestamp": { "type": "string", "description": "Format tanggal dan jam tampilan" },
        "createdAt": { "type": "number", "description": "Epoch timestamp" }
      },
      "required": ["senderUsername", "senderRole"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Profil dan akun pengguna sistem"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Katalog menu makanan dan minuman"
    },
    "/transactions/{trxId}": {
      "schema": "Transaction",
      "description": "Pencatatan riwayat transaksi penjualan POS"
    },
    "/employees/{empId}": {
      "schema": "Employee",
      "description": "Master data kepegawaian dan gaji karyawan"
    },
    "/payroll/{slipId}": {
      "schema": "Payroll",
      "description": "Histori slip penggajian staf dan karyawan"
    },
    "/admin_conversations/{username}": {
      "schema": "AdminConversation",
      "description": "Metadata percakapan 1-on-1 user dengan admin"
    },
    "/admin_chats/{username}/messages/{msgId}": {
      "schema": "AdminChatMessage",
      "description": "Pesan chat pribadi antara user dan admin"
    },
    "/group_messages/{msgId}": {
      "schema": "GroupChatMessage",
      "description": "Pesan obrolan dalam grup pengguna aplikasi"
    }
  }
}
